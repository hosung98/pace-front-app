# EXPO_PUBLIC 값은 앱 번들에 포함됩니다. 비밀번호나 클라이언트 시크릿을 넣지 마세요.
# /dev/api는 프록시 접두사이고 /api/v1은 백엔드 경로이므로 api가 두 번 등장합니다.
EXPO_PUBLIC_API_BASE_URL=https://hosung-macmini.tailfb288b.ts.net/dev/api/api/v1
# EAS 채널/빌드 프로필과 별개인 API 환경입니다. production은 운영 API URL과 함께 설정하세요.
# development: PACE 로고 옆 DEV 표시, production: 환경 표시 없음
EXPO_PUBLIC_APP_ENV=development
