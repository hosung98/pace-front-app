{
  "expo": {
    "name": "PACE",
    "slug": "pace-front-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./public/pwa-512.png",
    "scheme": "pacefrontapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.hocompany.pace",
      "icon": "./public/pwa-512.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0D0F",
        "foregroundImage": "./public/pwa-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0D0F",
          "image": "./assets/images/pace-mark.png",
          "imageWidth": 88
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PACE에서 러닝 게시물에 사진을 추가하기 위해 사진 라이브러리에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "러닝 중 GPS로 거리와 속도를 기록하고, 크루 찾기에서 내 동네(시/군/구)를 찾기 위해 위치를 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": "화면이 잠긴 상태에서도 러닝을 기록하기 위해 위치를 사용합니다. 러닝을 종료하면 수집을 중단합니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-asset",
      "expo-maps",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.hocompany.pace.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.hocompany.pace",
          "frequentUpdates": true
        }
      ],
      [
        "@react-native-google-signin/google-signin/app.plugin.js",
        {
          "iosUrlScheme": "com.googleusercontent.apps.569856299617-2ulippt30k87ubgkq1sotovovlfvsst7"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "baseUrl": "/dev",
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c94c264-6696-4c02-b5bc-6debfd999b68"
      }
    },
    "owner": "kimhosung",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c94c264-6696-4c02-b5bc-6debfd999b68"
    }
  }
}
